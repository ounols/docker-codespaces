{
  "name": "Kali Linux - Shannon Uncontained",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "kali",
  "capAdd": ["NET_RAW", "NET_ADMIN"],
  "forwardPorts": [],
  "postCreateCommand": "~/init.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
